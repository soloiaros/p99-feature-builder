# Copy to .dev.vars for local development. Configure deployed keys with Wrangler secrets.
# Never commit the real .dev.vars file or expose these through VITE_ variables.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
# OpenRouter is also supported: set OPENROUTER_API_KEY and omit JEV_API_KEY,
# or select JEV_BASE_URL=https://openrouter.ai/api/v1 for a JEV_API_KEY issued there.

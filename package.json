    "robot-heads": "^0.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
